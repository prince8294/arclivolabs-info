# MongoDB Atlas URI or local MongoDB connection string.
MONGODB_URI=

# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js canonical deployment URL (keep NEXTAUTH_URL for compatibility).
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary image and media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=
CLOUDINARY_MEDIA_UPLOAD_PRESET=

# Resend email delivery. Without both values, messages remain queued and are not sent.
RESEND_API_KEY=
EMAIL_FROM=

# Protect GET /api/cron with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional, development only. `npm run seed` refuses to run in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
